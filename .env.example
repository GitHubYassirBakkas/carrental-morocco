## Local development template.
## Do not copy this file unchanged to production. Use DEPLOYMENT.md for required
## production values and provide real secrets through the server environment.

APP_NAME="Car Rental Morocco"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SAFE_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Local development may use sqlite. Production should use mysql or mariadb.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false
QUEUE_CONNECTION=redis
WEBHOOK_QUEUE_CONNECTION=database
WEBHOOK_QUEUE=stripe-webhooks

CACHE_STORE=redis
# CACHE_PREFIX=

# Leave blank when there is no reverse proxy. In production, use comma-separated
# trusted proxy IPs/CIDRs. Do not use * in production.
TRUSTED_PROXIES=

SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=true
SECURITY_HSTS_ENABLED=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

MAIL_MAILER=resend
RESEND_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
